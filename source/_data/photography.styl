.photography-page .post-block
  padding: 28px 30px 36px
  border-color: var(--journal-rule)

.photography-page .section-hero
  width: 100%
  margin: 0

.photo-collection-heading
  display: flex
  align-items: end
  justify-content: space-between
  gap: 12px
  margin-bottom: 24px
  padding-bottom: 15px
  border-bottom: 1px solid var(--journal-rule)

.photo-collection-heading h2
  margin: 0
  font-size: 26px
  line-height: 1.45

.photo-collection-heading .home-intro-kicker
  margin: 0 0 7px

.photo-collection-count
  color: var(--journal-muted)
  font-size: 13px
  white-space: nowrap

.photo-collection
  columns: 2
  column-gap: 24px

.photo-frame
  display: inline-block
  width: 100%
  margin: 0 0 24px
  border: 0
  vertical-align: top
  break-inside: avoid
  cursor: zoom-in

.photo-frame img
  display: block
  width: 100%
  height: auto
  margin: 0
  background: #f5f5f2

.photo-frame:focus-visible
  outline: 2px solid #002fa7
  outline-offset: 5px

.photo-collection-single
  columns: auto

.photo-collection-single .photo-frame
  display: block
  max-width: 560px
  margin: 0 auto

@media (max-width: 767px)
  .photography-page .post-block
    padding: 24px 20px 28px

  .photo-collection-heading h2
    font-size: 23px

@media (max-width: 540px)
  .photo-collection
    columns: 1

html:has(.photo-viewer[open])
  overflow: hidden

.photo-viewer
  position: fixed
  inset: 0
  box-sizing: border-box
  width: calc(100% - 24px)
  height: calc(100% - 24px)
  max-width: 1200px
  max-height: none
  margin: auto
  padding: 12px
  border: 0
  background: transparent
  color: #fff

.photo-viewer::backdrop
  background: rgba(15, 17, 21, .95)

.photo-viewer[open]
  display: grid
  grid-template-areas: 'top top top' 'prev stage next' 'position position position'
  grid-template-columns: 44px minmax(0, 1fr) 44px
  grid-template-rows: auto minmax(0, 1fr) auto
  gap: 12px 20px
  align-items: center

.photo-viewer-top
  grid-area: top
  justify-self: end

.photo-viewer-stage
  grid-area: stage
  align-self: stretch
  min-width: 0
  min-height: 0

.photo-viewer-image
  display: block
  width: 100%
  height: 100%
  object-fit: contain
  user-select: none

.photo-viewer-prev
  grid-area: prev

.photo-viewer-next
  grid-area: next

.photo-viewer-position
  grid-area: position
  text-align: center
  font-size: 13px
  font-variant-numeric: tabular-nums

.photo-viewer button
  display: grid
  width: 44px
  height: 44px
  place-items: center
  padding: 0
  border: 1px solid rgba(255, 255, 255, .35)
  border-radius: 50%
  color: #fff
  background: transparent
  font: 30px/1 Arial, sans-serif
  cursor: pointer
  touch-action: manipulation

.photo-viewer button:hover:not([aria-disabled='true'])
  background: rgba(255, 255, 255, .14)

.photo-viewer button[aria-disabled='true']
  opacity: .35
  cursor: default

.photo-viewer button:focus-visible
  outline: 2px solid #adc3ff
  outline-offset: 3px

@media (max-width: 600px)
  .photo-viewer[open]
    grid-template-areas: 'top top top' 'stage stage stage' 'prev position next'
    gap: 12px
