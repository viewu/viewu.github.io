.home-intro
  margin-bottom: 28px
  padding: 38px 40px 34px
  border: 1px solid rgba(66, 170, 240, 0.22)
  border-radius: 8px
  background: linear-gradient(135deg, rgba(66, 170, 240, 0.09), rgba(255, 255, 255, 0.72))

.home-intro-kicker
  margin: 0 0 10px
  color: #4d87a8
  font-size: 0.72em
  font-weight: 700
  letter-spacing: 0.16em

.home-intro h2
  margin: 0 0 14px
  color: #263238
  font-size: 1.75em
  line-height: 1.35

.home-intro p:not(.home-intro-kicker)
  max-width: 680px
  margin: 0 0 18px
  color: #59656c
  line-height: 1.9

.home-intro-link
  display: inline-flex
  align-items: center
  gap: 8px
  color: #357b9f
  font-weight: 600

.home-intro-link:hover
  color: #24566f

.home-topics
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px
  margin-bottom: 38px

.home-topic-card
  position: relative
  display: block
  min-height: 172px
  padding: 22px 22px 20px
  border: 1px solid #e7edf0
  border-radius: 8px
  background: #fff
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease

.home-topic-card:hover
  border-color: rgba(66, 170, 240, 0.55)
  box-shadow: 0 8px 22px rgba(38, 50, 56, 0.08)
  transform: translateY(-2px)

.home-topic-index
  color: #8b989e
  font-size: 0.72em
  letter-spacing: 0.12em

.home-topic-card h3
  margin: 12px 0 8px
  color: #263238
  font-size: 1.1em

.home-topic-card p
  margin: 0
  padding-right: 16px
  color: #68757b
  font-size: 0.9em
  line-height: 1.7

.home-topic-arrow
  position: absolute
  right: 20px
  bottom: 18px
  color: #4d87a8

.home-start-here
  margin-bottom: 42px
  padding: 28px 30px 8px
  border-top: 1px solid #e7edf0
  border-bottom: 1px solid #e7edf0

.home-section-heading h2,
.home-latest-heading h2
  margin: 0 0 8px
  color: #263238
  font-size: 1.45em

.home-section-heading p:last-child
  margin: 0 0 18px
  color: #7b878d

.home-featured-list
  display: grid
  gap: 0

.home-featured-item
  display: grid
  grid-template-columns: 36px 1fr 18px
  align-items: center
  gap: 14px
  padding: 15px 0
  border-top: 1px solid #eef2f3
  color: #39464c

.home-featured-item span
  color: #9aa7ac
  font-size: 0.8em
  letter-spacing: 0.08em

.home-featured-item strong
  font-weight: 600

.home-featured-item i
  color: #4d87a8
  transition: transform 0.2s ease

.home-featured-item:hover
  color: #357b9f

.home-featured-item:hover i
  transform: translateX(3px)

.home-latest-heading
  margin: 0 0 22px

@media (max-width: 767px)
  .home-intro
    padding: 28px 24px 26px

  .home-intro h2
    font-size: 1.45em

  .home-topics
    grid-template-columns: 1fr
    gap: 10px

  .home-topic-card
    min-height: auto

  .home-start-here
    padding: 24px 20px 6px

  .home-featured-item
    grid-template-columns: 28px 1fr 16px
    gap: 10px
    font-size: 0.94em
