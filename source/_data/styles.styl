// Lightweight Bilibili-style brand icon for the social link.
.bilibili-icon
  position: relative
  display: inline-block
  width: 1.08em
  height: 0.82em
  border: 0.13em solid #00aeec
  border-radius: 0.24em
  box-sizing: border-box
  vertical-align: -0.08em

.bilibili-icon::before
  content: ''
  position: absolute
  left: 0.22em
  top: 0.24em
  width: 0.14em
  height: 0.14em
  border-radius: 50%
  background: #00aeec
  box-shadow: 0.36em 0 0 #00aeec

.bilibili-icon::after
  content: ''
  position: absolute
  left: 0.3em
  top: 0.42em
  width: 0.34em
  height: 0.1em
  border-bottom: 0.1em solid #00aeec
  border-radius: 0 0 0.3em 0.3em

// Refined brand cards for the four social links.
.social-brand-icons
  display: flex
  flex-wrap: wrap
  gap: 8px 0

.links-of-author
  margin-top: 14px

.links-of-author-item
  width: 50%
  margin: 0
  padding: 0 3px
  box-sizing: border-box

.links-of-author-item a
  display: flex
  align-items: center
  gap: 7px
  min-height: 34px
  padding: 5px 7px 5px 6px
  border: 1px solid rgba(126, 149, 159, 0.2)
  border-radius: 12px
  background: rgba(255, 255, 255, 0.58)
  box-shadow: 0 5px 14px rgba(62, 87, 96, 0.06)
  color: var(--text-color)
  font-size: 0.82em
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease

.links-of-author-item a:hover
  transform: translateY(-2px)
  border-color: rgba(92, 135, 156, 0.42)
  background: rgba(255, 255, 255, 0.9)
  box-shadow: 0 9px 20px rgba(62, 87, 96, 0.12)

.links-of-author-item a i
  flex: 0 0 24px
  width: 24px
  height: 24px
  margin-right: 0 !important
  display: inline-flex
  align-items: center
  justify-content: center
  border: 0
  border-radius: 8px
  box-sizing: border-box
  color: #fff
  font-size: 0.9em
  line-height: 1
  box-shadow: 0 3px 8px rgba(34, 56, 64, 0.16)

.links-of-author-item a[href*='space.bilibili.com'] i
  background: linear-gradient(135deg, #00aeec, #2389db)

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon
  width: 24px
  height: 24px
  border: 0
  border-radius: 8px
  background: linear-gradient(135deg, #00aeec, #2389db)
  vertical-align: middle

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::before
  content: 'B'
  left: 0
  top: 0
  width: 100%
  height: 100%
  background: transparent
  box-shadow: none
  color: #fff
  font-size: 0.9em
  font-weight: 800
  line-height: 24px
  text-align: center

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::after
  display: none

.links-of-author-item a[href*='music.163.com'] i
  background: linear-gradient(135deg, #f14d6c, #c52d55)

.links-of-author-item a[href*='xiaohongshu.com'] i
  background: linear-gradient(135deg, #ff4b4b, #e12d62)

.links-of-author-item a[href='/wechat/'] i
  background: linear-gradient(135deg, #20c978, #07a85a)

// Use the searched, local brand SVG assets instead of CSS-drawn approximations.
.social-brand-assets
  display: block

.links-of-author-item a[href*='space.bilibili.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/bilibili.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(0, 174, 236, 0.28)

.links-of-author-item a[href*='music.163.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/neteasecloudmusic.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(212, 60, 51, 0.24)

.links-of-author-item a[href*='xiaohongshu.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/xiaohongshu.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(255, 36, 66, 0.24)

.links-of-author-item a[href='/wechat/'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/wechat.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(7, 193, 96, 0.24)

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::before
  display: none

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::after
  display: none

// Image-based social icons preserve the original logo proportions at sidebar size.
.social-brand-icon
  display: block
  flex: 0 0 28px
  width: 28px
  height: 28px
  padding: 3px
  border: 1px solid rgba(126, 149, 159, 0.18)
  border-radius: 9px
  box-sizing: border-box
  object-fit: contain
  background: rgba(255, 255, 255, 0.92)
  box-shadow: 0 3px 8px rgba(34, 56, 64, 0.1)
  transition: transform 0.22s ease, box-shadow 0.22s ease

.links-of-author-item a:hover .social-brand-icon
  transform: scale(1.06)
  box-shadow: 0 5px 12px rgba(34, 56, 64, 0.16)

.links-of-author-item a[href*='space.bilibili.com'] .social-brand-icon
  border-color: rgba(0, 174, 236, 0.3)

.links-of-author-item a[href*='music.163.com'] .social-brand-icon
  border-color: rgba(212, 60, 51, 0.3)

.links-of-author-item a[href*='xiaohongshu.com'] .social-brand-icon
  border-color: rgba(255, 36, 66, 0.3)

.links-of-author-item a[href='/wechat/'] .social-brand-icon
  border-color: rgba(7, 193, 96, 0.3)

// Keep social cards in an even grid with a dedicated label column.
.social-layout-aligned
  display: block

.links-of-author
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 8px
  align-items: stretch

.links-of-author-item
  width: auto
  min-width: 0
  margin: 0
  padding: 0

.links-of-author-item a
  width: 100%
  min-width: 0
  height: 100%
  justify-content: flex-start
  overflow: hidden

.social-brand-label
  display: block
  flex: 1 1 auto
  min-width: 0
  overflow: hidden
  text-align: left
  text-overflow: ellipsis
  white-space: nowrap
  line-height: 1.35

@media (max-width: 767px)
  .links-of-author-item a
    padding-left: 5px
    padding-right: 5px

  .social-brand-icon
    flex-basis: 26px
    width: 26px
    height: 26px
    padding: 2px

// ============================================================
// 克莱因蓝 · 极简重涂 (2026-08-13)
// 黑白灰 + 克莱因蓝 #002FA7 · 宋体标题 · 去装饰 · 系统字体
// 追加覆盖：等价特异性下后声明者优先；不动既有结构与主题本体
// ============================================================

// ---- 主题变量（侧栏 / 导航 / 页脚 / 分页 / 按钮 / 代码块）----
:root
  --body-bg-color: #fafafa
  --content-bg-color: #ffffff
  --card-bg-color: #ffffff
  --text-color: #1a1a1a
  --blockquote-color: #6b6b6b
  --link-color: #1a1a1a
  --link-hover-color: #002fa7
  --brand-color: #1a1a1a
  --brand-hover-color: #002fa7
  --table-row-odd-bg-color: #fafafa
  --table-row-hover-bg-color: #f4f4f4
  --menu-item-bg-color: #fafafa
  --theme-color: #002fa7
  --btn-default-bg: #ffffff
  --btn-default-color: #1a1a1a
  --btn-default-border-color: #e0e0e0
  --btn-default-hover-bg: #002fa7
  --btn-default-hover-color: #ffffff
  --btn-default-hover-border-color: #002fa7
  --highlight-background: #f7f7f7
  --highlight-foreground: #4a4a4a

// ---- 基础底色 ----
body
  background: #fafafa
  color: #1a1a1a

// ---- 站名（宋体 · 墨色 · 安静）----
.site-title
  color: #1a1a1a
  font-family: "Songti SC", "STSong", "SimSun", serif
  font-weight: 500
  letter-spacing: 0.01em

.site-subtitle
  color: #9e9e9e
  letter-spacing: 0.04em

// ---- 宋体标题（全局）----
h1, h2, h3, h4, h5, h6,
.post-title,
.post-title-link,
.home-intro h2,
.home-topic-card h3,
.home-section-heading h2,
.home-latest-heading h2
  font-family: "Songti SC", "STSong", "SimSun", serif
  font-weight: 500

// ---- 首页引言（签名：克莱因蓝批注竖线）----
.home-intro
  background: #ffffff
  border: 1px solid #eeeeee
  border-left: 3px solid #002fa7
  border-radius: 0
  box-shadow: none

.home-intro h2
  color: #1a1a1a
  letter-spacing: 0

.home-intro-kicker
  color: #9e9e9e
  letter-spacing: 0.14em

.home-intro p:not(.home-intro-kicker)
  color: #6b6b6b

.home-intro-link
  color: #002fa7
  font-weight: 500

.home-intro-link:hover
  color: #002fa7
  text-decoration: underline

// ---- 话题卡片 ----
.home-topic-card
  background: #ffffff
  border-color: #eeeeee
  border-radius: 0
  box-shadow: none
  transition: border-color 0.15s ease

.home-topic-card:hover
  border-color: #002fa7
  box-shadow: none
  transform: none

.home-topic-card h3
  color: #1a1a1a

.home-topic-card p
  color: #6b6b6b

.home-topic-index
  color: #9e9e9e

.home-topic-arrow
  color: #9e9e9e

// ---- start-here / 精选 / 视频 / 最新 ----
.home-start-here
  border-top-color: #eeeeee
  border-bottom-color: #eeeeee

.home-section-heading h2,
.home-latest-heading h2
  color: #1a1a1a

.home-section-heading p:last-child
  color: #9e9e9e

.home-featured-item
  border-top-color: #eeeeee
  color: #1a1a1a

.home-featured-item span
  color: #9e9e9e

.home-featured-item i
  color: #9e9e9e

.home-featured-item:hover
  color: #002fa7

.home-featured-item:hover i
  color: #002fa7
  transform: translateX(3px)

.home-video-section
  border-top-color: #eeeeee
  border-bottom-color: #eeeeee

.home-video-item
  border-top-color: #eeeeee
  color: #1a1a1a

.home-video-item span
  color: #9e9e9e

.home-video-item small
  color: #9e9e9e

.home-video-item i
  color: #9e9e9e

.home-video-item:hover
  color: #002fa7

// ---- 文章列表 ----
.posts-expand .post-block
  background: #ffffff
  border: 1px solid #eeeeee
  border-radius: 0
  box-shadow: none

.posts-expand .post-title-link
  color: #1a1a1a

.posts-expand .post-title-link:hover
  color: #002fa7

.posts-expand .post-body
  color: #6b6b6b

.post-button .btn
  border-radius: 0
  border-color: #e0e0e0
  color: #1a1a1a
  letter-spacing: 0.02em

.post-button .btn:hover
  border-color: #002fa7
  background: #002fa7
