  background: #f6f8f9
  color: #39464d

.site-title
  letter-spacing: 0.035em
  font-weight: 600

.site-subtitle
  color: #7d8b92
  letter-spacing: 0.08em

.main-inner
  padding-top: 28px

.home-intro
  padding: 42px 46px 38px
  border: 1px solid #e4eaed
  border-left: 3px solid #5c879c
  border-radius: 3px
  background: #fff
  box-shadow: 0 12px 32px rgba(41, 55, 63, 0.055)

.home-intro h2
  color: #26343b
  font-weight: 600
  letter-spacing: 0.015em

.home-intro-kicker
  color: #5c879c
  font-size: 0.68em
  letter-spacing: 0.18em

.home-topic-card
  min-height: 168px
  border-color: #e4eaed
  border-radius: 3px
  box-shadow: 0 6px 18px rgba(41, 55, 63, 0.035)

.home-topic-card:hover
  border-color: #9bb5c2
  box-shadow: 0 12px 26px rgba(41, 55, 63, 0.08)

.home-topic-card h3
  font-weight: 600
  letter-spacing: 0.01em

.home-start-here
  padding-top: 30px
  border-top-color: #dfe6e9
  border-bottom-color: #dfe6e9

.home-featured-item
