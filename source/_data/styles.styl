  background: #5c879c
  color: #fff

@media (max-width: 767px)
  .main-inner
    padding-top: 16px

  .home-intro
    padding: 30px 24px 28px

  .posts-expand .post-block
    padding: 24px 20px 8px
    border-right: 0
    border-left: 0
.home-video-section
  margin-bottom: 40px
  padding: 28px 30px 26px
  border-top: 1px solid #dfe6e9
  border-bottom: 1px solid #dfe6e9

.home-video-list
  display: grid
  gap: 0
  margin-bottom: 18px

.home-video-item
  display: grid
  grid-template-columns: 70px 1fr 18px
  align-items: center
  gap: 14px
  padding: 15px 0
  border-top: 1px solid #eef2f3
  color: #43535b

.home-video-item span
  color: #9aa7ac
  font-size: 0.72em
  letter-spacing: 0.1em

.home-video-item strong
  font-weight: 500

.home-video-item small
  margin-left: 8px
  color: #97a4a9
  font-size: 0.78em
  font-weight: 400

.home-video-item i
  color: #5c879c

.home-video-item:hover
  color: #4d8197

@media (max-width: 767px)
  .home-video-section
    padding: 24px 20px 22px

  .home-video-item
    grid-template-columns: 62px 1fr 16px
    gap: 9px

  .home-video-item small
    display: block
    margin: 4px 0 0
// Lightweight Bilibili-style brand icon for the social link.
.bilibili-icon
  position: relative
  display: inline-block
  width: 1.08em
  height: 0.82em
  border: 0.13em solid #00aeec
  border-radius: 0.24em
  box-sizing: border-box
  vertical-align: -0.08em

.bilibili-icon::before
  content: ''
  position: absolute
  left: 0.22em
  top: 0.24em
  width: 0.14em
  height: 0.14em
  border-radius: 50%
  background: #00aeec
  box-shadow: 0.36em 0 0 #00aeec

.bilibili-icon::after
  content: ''
  position: absolute
  left: 0.3em
  top: 0.42em
  width: 0.34em
  height: 0.1em
  border-bottom: 0.1em solid #00aeec
  border-radius: 0 0 0.3em 0.3em

// Refined brand cards for the four social links.
.social-brand-icons
  display: flex
  flex-wrap: wrap
  gap: 8px 0

.links-of-author
  margin-top: 14px

.links-of-author-item
  width: 50%
  margin: 0
  padding: 0 3px
  box-sizing: border-box

.links-of-author-item a
  display: flex
  align-items: center
  gap: 7px
  min-height: 34px
  padding: 5px 7px 5px 6px
  border: 1px solid rgba(126, 149, 159, 0.2)
  border-radius: 12px
  background: rgba(255, 255, 255, 0.58)
  box-shadow: 0 5px 14px rgba(62, 87, 96, 0.06)
  color: var(--text-color)
  font-size: 0.82em
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease

.links-of-author-item a:hover
  transform: translateY(-2px)
  border-color: rgba(92, 135, 156, 0.42)
  background: rgba(255, 255, 255, 0.9)
  box-shadow: 0 9px 20px rgba(62, 87, 96, 0.12)

.links-of-author-item a i
  flex: 0 0 24px
  width: 24px
  height: 24px
  margin-right: 0 !important
  display: inline-flex
  align-items: center
  justify-content: center
  border: 0
  border-radius: 8px
  box-sizing: border-box
  color: #fff
  font-size: 0.9em
  line-height: 1
  box-shadow: 0 3px 8px rgba(34, 56, 64, 0.16)

.links-of-author-item a[href*='space.bilibili.com'] i
  background: linear-gradient(135deg, #00aeec, #2389db)

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon
  width: 24px
  height: 24px
  border: 0
  border-radius: 8px
  background: linear-gradient(135deg, #00aeec, #2389db)
  vertical-align: middle

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::before
  content: 'B'
  left: 0
  top: 0
  width: 100%
  height: 100%
  background: transparent
  box-shadow: none
  color: #fff
  font-size: 0.9em
  font-weight: 800
  line-height: 24px
  text-align: center

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::after
  display: none

.links-of-author-item a[href*='music.163.com'] i
  background: linear-gradient(135deg, #f14d6c, #c52d55)

.links-of-author-item a[href*='xiaohongshu.com'] i
  background: linear-gradient(135deg, #ff4b4b, #e12d62)

.links-of-author-item a[href='/wechat/'] i
  background: linear-gradient(135deg, #20c978, #07a85a)

// Use the searched, local brand SVG assets instead of CSS-drawn approximations.
.social-brand-assets
  display: block

.links-of-author-item a[href*='space.bilibili.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/bilibili.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(0, 174, 236, 0.28)

.links-of-author-item a[href*='music.163.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/neteasecloudmusic.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(212, 60, 51, 0.24)

.links-of-author-item a[href*='xiaohongshu.com'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/xiaohongshu.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(255, 36, 66, 0.24)

.links-of-author-item a[href='/wechat/'] i
  background-color: rgba(255, 255, 255, 0.92)
  background-image: url('/images/social/wechat.svg')
  background-repeat: no-repeat
  background-position: center
  background-size: 17px 17px
  border: 1px solid rgba(7, 193, 96, 0.24)

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::before
  display: none

.links-of-author-item a[href*='space.bilibili.com'] .bilibili-icon::after
  display: none

// Image-based social icons preserve the original logo proportions at sidebar size.
.social-brand-icon
  display: block
  flex: 0 0 28px
  width: 28px
  height: 28px
  padding: 3px
  border: 1px solid rgba(126, 149, 159, 0.18)
  border-radius: 9px
  box-sizing: border-box
  object-fit: contain
  background: rgba(255, 255, 255, 0.92)
  box-shadow: 0 3px 8px rgba(34, 56, 64, 0.1)
  transition: transform 0.22s ease, box-shadow 0.22s ease

.links-of-author-item a:hover .social-brand-icon
  transform: scale(1.06)
  box-shadow: 0 5px 12px rgba(34, 56, 64, 0.16)

.links-of-author-item a[href*='space.bilibili.com'] .social-brand-icon
  border-color: rgba(0, 174, 236, 0.3)

.links-of-author-item a[href*='music.163.com'] .social-brand-icon
  border-color: rgba(212, 60, 51, 0.3)

.links-of-author-item a[href*='xiaohongshu.com'] .social-brand-icon
  border-color: rgba(255, 36, 66, 0.3)

.links-of-author-item a[href='/wechat/'] .social-brand-icon
  border-color: rgba(7, 193, 96, 0.3)

// Keep social cards in an even grid with a dedicated label column.
.social-layout-aligned
  display: block

.links-of-author
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 8px
  align-items: stretch

.links-of-author-item
  width: auto
  min-width: 0
  margin: 0
  padding: 0

.links-of-author-item a
  width: 100%
  min-width: 0
  height: 100%
  justify-content: flex-start
  overflow: hidden

.social-brand-label
  display: block
  flex: 1 1 auto
  min-width: 0
  overflow: hidden
  text-align: left
  text-overflow: ellipsis
  white-space: nowrap
  line-height: 1.35

@media (max-width: 767px)
  .links-of-author-item a
    padding-left: 5px
    padding-right: 5px

  .social-brand-icon
    flex-basis: 26px
    width: 26px
    height: 26px
    padding: 2px
