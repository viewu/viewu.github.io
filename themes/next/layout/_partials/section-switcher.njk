<nav class="section-switcher" aria-label="板块切换">
  <a class="section-switcher-link section-switcher-prev" href="{{ url_for(previousSectionUrl) }}" aria-label="切换到上一个板块：{{ previousSectionTitle }}" title="{{ previousSectionTitle }}">
    <i class="fa fa-arrow-left" aria-hidden="true"></i>
  </a>
  <h1 class="section-switcher-title {{ sectionTitleClass }}" itemprop="name headline">{{ currentSectionTitle }}</h1>
  <a class="section-switcher-link section-switcher-next" href="{{ url_for(nextSectionUrl) }}" aria-label="切换到下一个板块：{{ nextSectionTitle }}" title="{{ nextSectionTitle }}">
    <i class="fa fa-arrow-right" aria-hidden="true"></i>
  </a>
</nav>