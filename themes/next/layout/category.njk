{% extends '_layout.njk' %}
{% import '_macro/post-collapse.njk' as post_template with context %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ __('title.category') }}: {{ page.category }} | {{ title }}{% endblock %}

{% block class %}category posts-collapse{% endblock %}

{% block content %}

  {%- set currentSectionTitle = page.category %}
  {%- set sectionTitleClass = 'category-title' %}
  {%- set previousSectionTitle = '' %}
  {%- set previousSectionUrl = '' %}
  {%- set nextSectionTitle = '' %}
  {%- set nextSectionUrl = '' %}
  {%- if page.category == '工作' %}
    {%- set previousSectionTitle = '运动' %}
    {%- set previousSectionUrl = '/categories/运动/' %}
    {%- set nextSectionTitle = '成长' %}
    {%- set nextSectionUrl = '/categories/成长/' %}
  {%- elif page.category == '成长' %}
    {%- set previousSectionTitle = '工作' %}
    {%- set previousSectionUrl = '/categories/工作/' %}
    {%- set nextSectionTitle = '写作' %}
    {%- set nextSectionUrl = '/categories/写作/' %}
  {%- elif page.category == '写作' %}
    {%- set previousSectionTitle = '成长' %}
    {%- set previousSectionUrl = '/categories/成长/' %}
    {%- set nextSectionTitle = '音乐' %}
    {%- set nextSectionUrl = '/music/' %}
  {%- elif page.category == '运动' %}
    {%- set previousSectionTitle = '音乐' %}
    {%- set previousSectionUrl = '/music/' %}
    {%- set nextSectionTitle = '工作' %}
    {%- set nextSectionUrl = '/categories/工作/' %}
  {%- endif %}

  <div class="post-block">
    <div class="category-title-wrap">
      {%- if previousSectionUrl and nextSectionUrl %}
        {%- include '_partials/section-switcher.njk' -%}
      {%- else %}
        <h1 class="category-title">{{ page.category }}</h1>
      {%- endif %}
    </div>

    {%- if page.category == '工作' %}
    <div class="section-hero">
      <img src="{{ url_for('/images/sections/hero-work.webp') }}" alt="工作" loading="lazy" decoding="async" width="1000" height="1500">
    </div>
    {%- elif page.category == '成长' %}
    <div class="section-hero">
      <img src="{{ url_for('/images/sections/hero-growth.webp') }}" alt="成长" loading="lazy" decoding="async" width="1000" height="1500">
    </div>
    {%- elif page.category == '写作' %}
    <div class="section-hero">
      <img src="{{ url_for('/images/sections/hero-writing.webp') }}" alt="写作" loading="lazy" decoding="async" width="1000" height="1500">
    </div>
    {%- elif page.category == '运动' %}
    <div class="section-hero">
      <img src="{{ url_for('/images/sections/hero-sport.webp') }}" alt="运动" loading="lazy" decoding="async" width="1000" height="1500">
    </div>
    {%- endif %}

    <div class="post-content">
      {{ post_template.render(page.posts) }}
    </div>
  </div>

  {%- include '_partials/pagination.njk' -%}

{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
